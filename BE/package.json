{
  "name": "myticket-be",
  "version": "1.0.0",
  "description": "Backend project using Node.js with ES Modules and MVC structure",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "report": "npm test && node convert.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s"
    ],
    "verbose": true,
    "reporters": [
      "default",
      "jest-stare"
    ]
  },
  "keywords": [
    "nodejs",
    "express",
    "mvc",
    "backend"
  ],
  "author": "Quang",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/hub": "^2.11.0",
    "@payos/node": "^2.0.5",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.67.2",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-html-reporter": "^4.4.0",
    "jest-stare": "^2.5.3",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.10",
    "pandoc": "^0.2.0",
    "showdown": "^2.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2"
  }
}
